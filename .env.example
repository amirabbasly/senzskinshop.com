# ============================================================
#  SENZ SKIN SHOP — environment variables (copy to .env)
#  cp .env.example .env   (deploy.sh does this automatically)
# ============================================================

# ---------- database ----------
POSTGRES_DB=senzskinshop
POSTGRES_USER=senz
POSTGRES_PASSWORD=change-me-strong-password

# ---------- api ----------
# generate with: openssl rand -hex 32
JWT_SECRET=change-me-super-secret-jwt-key
JWT_EXPIRES_IN=30d

# first admin account (created on first boot, if there is no data yet)
ADMIN_EMAIL=admin@senzskinshop.com
ADMIN_PASSWORD=Senz@12345

# 1 = insert demo categories/products/settings when the database is empty
SEED_ON_BOOT=1

# allowed browser origins for the API (comma separated)
CORS_ORIGIN=https://senzskinshop.com,https://www.senzskinshop.com,http://localhost:3000

# ---------- nginx ----------
# --- پرداخت آنلاین ---
# mock = درگاه آزمایشی داخلی (پیشنهادی برای تست). برای درگاه واقعی،
# backend/src/payments.js را پیاده‌سازی کنید و نام درگاه را اینجا بگذارید.
PAYMENT_GATEWAY=mock

HTTP_PORT=80
HTTPS_PORT=443
